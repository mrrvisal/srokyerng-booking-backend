PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=srokyerng_booking_db

# TLS/SSL for managed MySQL (e.g. TiDB Cloud Serverless) that rejects insecure
# connections. Points to a CA bundle (system cert.pem or a custom issuer cert).
# Leave empty for local MySQL connections that do not require TLS.
SSL_CERT_PATH=
# Force TLS without a CA file (skips certificate verification — dev only).
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_COOKIE_SECURE=false
# local HTTP dev: keep "lax". Use "none" only with Secure=true (HTTPS).
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax

FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v23.0

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SrokYerng Booking <no-reply@example.com>"
SMTP_SECURE=false

# HTTP email API (preferred for Render/deployments — outbound 443 is never
# blocked). Priority: RESEND_API_KEY → SENDGRID_API_KEY → SMTP.
RESEND_API_KEY=
RESEND_FROM="SrokYerng Booking <onboarding@resend.dev>"
SENDGRID_API_KEY=
SENDGRID_FROM="SrokYerng Booking <no-reply@sendgrid.com>"

ADMIN_FULL_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
